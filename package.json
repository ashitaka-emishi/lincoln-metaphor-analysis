{
  "name": "lincoln-metaphor",
  "version": "1.0.0",
  "description": "Structured metaphor analysis of Lincoln's rhetoric, 1838-1865",
  "scripts": {
    "status": "node scripts/pipeline_status.js",
    "migrate:annotations": "node scripts/migrate_annotations_to_stage4.js",
    "validate": "node scripts/validate_schema.js && npm run validate:corpus-v4 && npm run validate:stage4m && npm run validate:stage4h && npm run validate:source-provenance",
    "validate:annotation": "node scripts/validate_annotation_output.js",
    "validate:corpus-v4": "node scripts/corpus/validate-corpus-inventory.js",
    "validate:stage4m": "node scripts/stage4m/ingest-model-outputs.js --check && node scripts/stage4m/validate-artifacts.js && node scripts/stage4m/generate-results-page.js --check",
    "validate:stage4h": "node scripts/stage4h/validate-artifacts.js && node scripts/stage4h/generate-human-reliability-report.js --check && node scripts/stage4j/generate-adjudication-results.js --check && node scripts/stage4j/generate-codebook-revision-notes.js --check",
    "validate:source-provenance": "node scripts/validate_source_provenance.js",
    "source:provenance": "node scripts/validate_source_provenance.js --write",
    "corpus:register": "node scripts/build_corpus_register.js",
    "evidence:chains": "node scripts/build_evidence_chains.js",
    "reliability:sample": "node scripts/build_reliability_sample.js",
    "reliability:results": "node scripts/build_reliability_results.js",
    "stage4m:packets": "node scripts/stage4m/generate-model-packets.js",
    "stage4m:ingest": "node scripts/stage4m/ingest-model-outputs.js",
    "stage4m:compare": "node scripts/stage4m/compare-model-runs.js",
    "stage4m:disagreements": "node scripts/stage4m/classify-model-disagreements.js",
    "stage4m:adjudication": "node scripts/stage4m/generate-adjudication-queue.js",
    "stage4m:queue": "node scripts/stage4m/generate-adjudication-queue.js",
    "stage4m:consensus": "node scripts/stage4m/generate-model-consensus-report.js",
    "stage4m:results": "node scripts/stage4m/generate-results-page.js",
    "stage4m": "npm run stage4m:packets && npm run stage4m:ingest && npm run stage4m:compare && npm run stage4m:disagreements && npm run stage4m:adjudication && npm run stage4m:consensus && npm run stage4m:results",
    "stage4h:packets": "node scripts/stage4h/generate-human-packets.js",
    "stage4h:ingest": "node scripts/stage4h/ingest-human-outputs.js",
    "stage4h:compare": "node scripts/stage4h/compare-human-runs.js",
    "stage4h:reference": "node scripts/stage4h/compare-human-to-reference.js",
    "stage4h:disagreements": "node scripts/stage4h/classify-human-disagreements.js",
    "stage4h:adjudication-queue": "node scripts/stage4h/generate-human-adjudication-queue.js",
    "stage4h:report": "node scripts/stage4h/generate-human-reliability-report.js",
    "stage4h": "npm run stage4h:packets && npm run stage4h:ingest && npm run stage4h:compare && npm run stage4h:reference && npm run stage4h:disagreements && npm run stage4h:adjudication-queue && npm run stage4j:ingest && npm run stage4h:report",
    "stage4j:ingest": "node scripts/stage4j/ingest-adjudication-decisions.js",
    "stage4j:results": "node scripts/stage4j/generate-adjudication-results.js",
    "stage4j:codebook-notes": "node scripts/stage4j/generate-codebook-revision-notes.js",
    "stage4j": "npm run stage4j:ingest && npm run stage4j:results && npm run stage4j:codebook-notes",
    "variants:apparatus": "node scripts/build_textual_variant_apparatus.js",
    "benchmarks:registry": "python3 scripts/build_external_benchmark_registry.py",
    "reception:registry": "python3 scripts/build_reception_evidence_registry.py",
    "analysis:controlled": "node scripts/build_controlled_analysis.js",
    "audit:claims": "node scripts/build_claim_audit.js",
    "concordance": "node scripts/build_concordance.js",
    "analysis": "node scripts/run_analysis.js",
    "pipeline": "npm run validate && npm run concordance && npm run analysis && npm run evidence:chains && npm run reliability:sample && npm run reliability:results && npm run variants:apparatus && npm run analysis:controlled && npm run audit:claims",
    "freshness:generated": "node scripts/check_generated_freshness.js",
    "stage7": "python3 scripts/run_stage7.py",
    "stage7:large": "python3 scripts/run_stage7.py --dataset large",
    "stage7:download": "python3 scripts/download_lcc.py",
    "stage7:download:large": "python3 scripts/download_lcc.py --dataset large",
    "stage7:parse": "python3 scripts/parse_lcc.py --input data/lcc/en_small.xml --output data/lcc_subset/en_small.csv",
    "stage7:parse:large": "python3 scripts/parse_lcc.py --input data/lcc/en_large.xml --output data/lcc_subset/en_large.csv",
    "stage7:eval": "python3 scripts/evaluate_lcc.py --output reports/stage7/LCC_report.md",
    "site": "quarto render",
    "site:links": "python3 scripts/check_site_links.py --external",
    "site:preview": "quarto preview",
    "test": "node --test tests/*.test.js",
    "check:quarto": "quarto --version || (echo 'Quarto not found. Install from https://quarto.org/docs/get-started/ or: brew install quarto' && exit 1)"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "^1.59.1"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  }
}
