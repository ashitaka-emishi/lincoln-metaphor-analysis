            {
              "sentence_id": "doc_041_s01_p03_s01",
              "sentence_ordinal": 1,
              "text": "MRS.",
              "word_offset_start": 9,
              "word_offset_end": 10,
              "authorship_note": null,
              "metaphor_instances": []
            },
            {
              "sentence_id": "doc_041_s01_p03_s02",
              "sentence_ordinal": 2,
              "text": "BIXBY, Boston, Massachusetts.",
              "word_offset_start": 10,
              "word_offset_end": 13,
              "authorship_note": null,
              "metaphor_instances": []
            }
          ]
        },
        {
          "paragraph_id": "doc_041_s01_p04",
          "paragraph_ordinal": 4,
          "sentences": [
            {
              "sentence_id": "doc_041_s01_p04_s01",
              "sentence_ordinal": 1,
              "text": "DEAR MADAM:--I have been shown in the files of the War Department a statement of the Adjutant-General of Massachusetts that you are the mother of five sons who have died gloriously on the field of battle.",
              "word_offset_start": 13,
              "word_offset_end": 49,
              "authorship_note": null,
              "metaphor_instances": []
            },
            {
              "sentence_id": "doc_041_s01_p04_s02",
              "sentence_ordinal": 2,
              "text": "I feel how weak and fruitless must be any words of mine which should attempt to beguile you from the grief of a loss so overwhelming.",
              "word_offset_start": 49,
              "word_offset_end": 75,
              "authorship_note": null,
              "metaphor_instances": []
            },
            {
              "sentence_id": "doc_041_s01_p04_s03",
              "sentence_ordinal": 3,
              "text": "But I cannot refrain from tendering to you the consolation that may be found in the thanks of the Republic they died to save.",
              "word_offset_start": 75,
              "word_offset_end": 99,
              "authorship_note": null,
              "metaphor_instances": []
            },
            {
              "sentence_id": "doc_041_s01_p04_s04",
              "sentence_ordinal": 4,
              "text": "I pray that our Heavenly Father may assuage the anguish of your bereavement, and leave you only the cherished memory of the loved and lost, and the solemn pride that must be yours to have laid so costly a sacrifice upon the altar of freedom.",
              "word_offset_start": 99,
              "word_offset_end": 144,
              "authorship_note": null,
              "metaphor_instances": []
            }
          ]
        },
        {
          "paragraph_id": "doc_041_s01_p05",
          "paragraph_ordinal": 5,
          "sentences": [
            {
              "sentence_id": "doc_041_s01_p05_s01",
              "sentence_ordinal": 1,
              "text": "Yours very sincerely and respectfully,",
              "word_offset_start": 144,
              "word_offset_end": 149,
              "authorship_note": null,
              "metaphor_instances": []
            }
          ]
        },
        {
          "paragraph_id": "doc_041_s01_p06",
