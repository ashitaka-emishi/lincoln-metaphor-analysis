              "sentence_ordinal": 1,
              "text": "EXECUTIVE MANSION, WASHINGTON, November 21, 1864.",
              "word_offset_start": 3,
              "word_offset_end": 9,
              "authorship_note": null,
              "metaphor_instances": []
            }
