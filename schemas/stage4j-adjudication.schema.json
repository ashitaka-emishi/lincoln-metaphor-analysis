{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ashitaka-emishi/lincoln-metaphor-analysis/schemas/stage4j-adjudication.schema.json",
  "title": "Stage 4J adjudication decisions",
  "description": "Canonical decision-file contract for completed Stage 4J human adjudication. Decisions resolve Stage 4H human-coder disagreements for review and never modify Stage 4A automatically.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_adjudication_queue",
    "adjudication_batch_id",
    "decisions"
  ],
  "properties": {
    "schema_version": {
      "const": "stage4j-adjudication-decisions-1.0"
    },
    "source_adjudication_queue": {
      "type": "string",
      "pattern": "^(data/reliability/human-adjudication/stage4j-adjudication-queue\\.json|tests/.+\\.json)$"
    },
    "adjudication_batch_id": {
      "type": "string",
      "pattern": "^stage4j_batch_[a-z0-9_-]+$"
    },
    "decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/decision" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "nullableString": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "null" }
      ]
    },
    "yesNo": {
      "enum": ["yes", "no"]
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adjudication_id",
        "doc_id",
        "sentence_id",
        "field_name",
        "decision",
        "adjudicated_value",
        "rationale",
        "codebook_change_needed",
        "codebook_change_type",
        "stage4a_correction_candidate",
        "requires_claim_audit_review",
        "adjudicator",
        "adjudication_date",
        "notes"
      ],
      "properties": {
        "adjudication_id": {
          "type": "string",
          "pattern": "^stage4j_[0-9]{4,}$",
          "description": "Stable queue identifier from stage4j-adjudication-queue.json."
        },
        "doc_id": {
          "type": "string",
          "pattern": "^doc_[0-9]{3}[a-z]?$"
        },
        "sentence_id": {
          "type": "string",
          "pattern": "^doc_[0-9]{3}[a-z]?_s[0-9]{2}_p[0-9]{2}_s[0-9]{2}$"
        },
        "field_name": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": [
            "accept_coder_a",
            "accept_coder_b",
            "accept_stage4a",
            "synthesize",
            "mark_uncertain",
            "exclude",
            "defer"
          ]
        },
        "adjudicated_value": { "$ref": "#/$defs/nullableString" },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "codebook_change_needed": { "$ref": "#/$defs/yesNo" },
        "codebook_change_type": {
          "enum": [
            "definition",
            "example",
            "controlled_vocabulary",
            "boundary_rule",
            "scope_rule",
            "none"
          ]
        },
        "stage4a_correction_candidate": { "$ref": "#/$defs/yesNo" },
        "requires_claim_audit_review": { "$ref": "#/$defs/yesNo" },
        "adjudicator": {
          "type": "string",
          "minLength": 1
        },
        "adjudication_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Calendar date in YYYY-MM-DD format."
        },
        "notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "decision": { "const": "defer" } },
            "required": ["decision"]
          },
          "then": {
            "properties": { "adjudicated_value": { "type": "null" } }
          }
        },
        {
          "if": {
            "properties": { "decision": { "const": "mark_uncertain" } },
            "required": ["decision"]
          },
          "then": {
            "properties": { "adjudicated_value": { "type": "null" } }
          }
        },
        {
          "if": {
            "properties": { "codebook_change_needed": { "const": "no" } },
            "required": ["codebook_change_needed"]
          },
          "then": {
            "properties": { "codebook_change_type": { "const": "none" } }
          }
        },
        {
          "if": {
            "properties": { "codebook_change_needed": { "const": "yes" } },
            "required": ["codebook_change_needed"]
          },
          "then": {
            "properties": {
              "codebook_change_type": {
                "enum": [
                  "definition",
                  "example",
                  "controlled_vocabulary",
                  "boundary_rule",
                  "scope_rule"
                ]
              }
            }
          }
        }
      ]
    }
  },
  "x-stage4j-csv": {
    "layout": "flattened-decisions",
    "description": "CSV decision files use the decision item fields as columns. Empty adjudicated_value cells normalize to JSON null only for defer or mark_uncertain decisions.",
    "metadata_columns": [
      "schema_version",
      "source_adjudication_queue",
      "adjudication_batch_id"
    ],
    "decision_columns": [
      "adjudication_id",
      "doc_id",
      "sentence_id",
      "field_name",
      "decision",
      "adjudicated_value",
      "rationale",
      "codebook_change_needed",
      "codebook_change_type",
      "stage4a_correction_candidate",
      "requires_claim_audit_review",
      "adjudicator",
      "adjudication_date",
      "notes"
    ]
  }
}
